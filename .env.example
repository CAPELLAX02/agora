# Agora API ortam değişkenleri. Kopyala: cp .env.example .env
# Development ortamında hepsinin varsayılanı vardır. test/production'da AGORA_DATABASE_URL zorunludur.

AGORA_ENV=development
AGORA_HTTP_ADDR=:8080
AGORA_METRICS_ADDR=:9091
AGORA_LOG_LEVEL=debug

AGORA_HTTP_READ_TIMEOUT=5s
AGORA_HTTP_WRITE_TIMEOUT=10s
AGORA_HTTP_IDLE_TIMEOUT=60s
AGORA_SHUTDOWN_TIMEOUT=15s

AGORA_DATABASE_URL=postgres://agora:agora_dev_password@localhost:5432/agora?sslmode=disable
AGORA_DB_MAX_CONNS=10
AGORA_DB_MIN_CONNS=2
AGORA_DB_MAX_CONN_LIFETIME=1h
AGORA_DB_MAX_CONN_IDLE_TIME=30m

AGORA_REDIS_URL=redis://localhost:6379/0

# Tarayıcıdan istek göndermesine izin verilen origin'ler (virgülle ayrılmış).
# Production'da web ve API aynı origin'den sunulduğu için boş bırakılır.
AGORA_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Kimlik doğrulama. Development'ta anahtar dosyası verilmezse her açılışta geçici bir
# anahtar üretilir. Production için: openssl genpkey -algorithm ed25519 -out jwt-ed25519.pem
# AGORA_JWT_PRIVATE_KEY_FILE=/run/secrets/jwt-ed25519.pem
AGORA_ACCESS_TOKEN_TTL=15m
AGORA_SESSION_IDLE_TIMEOUT=2h
AGORA_SESSION_ABSOLUTE_TIMEOUT=720h
AGORA_PASSWORD_HASH_WORKERS=4
AGORA_LOGIN_RATE_LIMIT=20

# E-posta ve worker. Development'ta e-postalar Mailpit'e gider: http://localhost:8025
AGORA_WEB_BASE_URL=http://localhost:5173
AGORA_SMTP_ADDR=localhost:1025
AGORA_SMTP_FROM=Agora <no-reply@agora.test>
# AGORA_SMTP_USERNAME=
# AGORA_SMTP_PASSWORD=
AGORA_WORKER_METRICS_ADDR=:9092
